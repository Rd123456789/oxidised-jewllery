# ---------------------------------------------------------------------------
# TEMPLATE ONLY — never put real credentials in this file, it is committed to git.
# Copy it to `server/.env` (which is gitignored) and fill in your values there.
#
#   copy server\.env.example server\.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- MongoDB (MongoDB Atlas) -------------------------------------------------
# 1. Create a free M0 cluster at https://www.mongodb.com/cloud/atlas/register
# 2. Security > Database Access > add a user with "Read and write to any database"
# 3. Security > Network Access > allow your current IP
# 4. Database > Connect > Drivers > Node.js > copy the connection string below
# URL-encode any special character in the password (@ -> %40, # -> %23, / -> %2F, : -> %3A)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/oxidised_jewellery?retryWrites=true&w=majority&appName=oxidised-jewellery
MONGODB_DB_NAME=oxidised_jewellery

# --- Auth --------------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# --- HTTP --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200
COOKIE_SECRET=replace-with-a-cookie-signing-secret
# COOKIE_DOMAIN=.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_MAX=25

# --- Cloudinary (product / banner images) ------------------------------------
# Console > Product Environment Credentials. Leave blank to fall back to local
# disk uploads under server/uploads (the store still works, just not CDN-served).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=oxidised-jewellery
UPLOAD_MAX_FILE_SIZE_MB=5

# --- Storefront bundle (single-origin deploy) --------------------------------
# The API serves web/dist/web/browser when it exists and falls back to the shell for
# client-side deep links. Set this only when the build lives somewhere else.
# WEB_DIST_DIR=C:\e-commerce\web\dist\web\browser

# --- Seed data ---------------------------------------------------------------
# Change these before seeding anything real.
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@oxidisedjewellery.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@oxidisedjewellery.test
SEED_CUSTOMER_PASSWORD=Customer@12345
